# Copy to ENV only on the operator host. Do not commit ENV.
export AWS_PROFILE=dev
export AWS_REGION=ap-southeast-1

# Required by offline/discover_pipeline_e2e.sh. Keep the real private S3 root
# in local scripts/ops/ENV; pipeline_e2e.tsv contains only relative keys.
export S3_ROOT=s3://replace-with-your-private-bucket/nextflow-offline

# Required only when create_ecr.sh creates a new ECR repository.
export ECR_TTL=31-12-27
