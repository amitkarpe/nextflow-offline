// Configuration overrides for running Nextflow in offline mode
// This file is intended to be used with the -c flag, e.g., nextflow run ... -c config/cache_override.config

// Example (Uncomment and adjust if needed):
// process {
//    withLabel: some_label {
//        memory = '16.GB' // Adjust resources for offline environment if different
//    }
// }

// docker {
//    enabled = true
    // runOptions = '-v /path/on/host:/path/in/container' // Add necessary volume mounts if required
// }

// Note: The primary mechanism for offline Docker images is:
// 1. Pre-saving images (.tar) using setup_online_cache.sh
// 2. Pre-loading images using `docker load < image.tar` on the offline machine.
// 3. Using the `-offline` flag during `nextflow run`.
// This config might be needed for overriding plugin paths or other specific adjustments. 