# Copy to .env and edit only what you need.
AWS_PROFILE=dev
# Set S3_ROOT or exact S3_BUNDLE_URI only when the S3 path is used.
S3_ROOT=
S3_BUNDLE_URI=
PIPELINE=demo
REVISION=1.0.2
WORK_ROOT=/tmp/nextflow-offline
IMAGE_MODE=archive
IMAGE_DEST_REGISTRY=
IMAGE_DEST_PREFIX=nextflow-offline
BUNDLE_CHANNEL=magic-v1
PUBLISH_S3=yes
OFFLINE_ROOT=/tmp/nextflow-offline-offline
RUN_PIPELINE=no
SKIP_S3_PULL=no
